---
import type { FoodAssetCategoryMap, FoodAssets } from "../types";
import {
  getSortedRecipeSectionEntries,
  type RecipeSectionEntry,
} from "../utils/food";
import RecipeList from "./RecipeList.astro";
import RecipeSection from "./RecipeSection.astro";

interface Props {
  recipes: FoodAssets | FoodAssetCategoryMap;
}

const { recipes } = Astro.props;
---

<div class="recipes">
  {
    !Array.isArray(recipes) ? (
      getSortedRecipeSectionEntries(recipes).map(
        ([category, recipesList]: RecipeSectionEntry) => (
          <RecipeSection category={category} recipeList={recipesList} />
        ),
      )
    ) : (
      <RecipeList recipeList={recipes} />
    )
  }
</div>
