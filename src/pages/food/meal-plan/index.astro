---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../constants';
import Layout from '../../../layouts/DefaultPageLayout.astro';
import {
  dinnerDishes,
  fixedMeals,
  meals,
  mealTotals,
  pantryStaples,
  selectedDinner,
  TARGETS,
  thisWeek,
  totals,
} from './mealPrepTargets';

const dinnerOptions = Object.values(dinnerDishes);
---

<style>
  /* ── Base ── */
  header {
    border-bottom: 1px solid #1e1e1e;
    padding: 40px 24px 32px;
  }
  .header-inner,
  .main-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #555;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .subtitle {
    color: #555;
    font-size: 13px;
    margin-top: 12px;
  }
  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 24px 48px;
  }
  .section-heading {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #444;
    text-transform: uppercase;
    margin: 32px 0 12px;
  }

  /* ── Week picker ── */
  .picker-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-bottom: 8px;

    @media screen and (min-width: 648px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .picker-card {
    border: 1px solid #1a1a1a;
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
    user-select: none;
  }
  .picker-card:hover {
    border-color: #2a2a2a;
  }
  .picker-card.selected {
    border-color: #c8a527;
    background: #fdf8e7;
  }
  .picker-card-cuisine {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: #555;
    text-transform: uppercase;
    margin-bottom: 3px;
  }
  .picker-card-name {
    font-size: 13px;
    font-weight: 600;
    color: #222;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .picker-card-link {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: #c8a527;
    text-decoration: none;
    letter-spacing: 0.06em;
    display: inline-block;
    margin-bottom: 6px;
  }
  .picker-card-link:hover {
    text-decoration: underline;
  }
  .picker-card-macros {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: #444;
  }
  .picker-card-desc {
    font-size: 11px;
    color: #3a3a3a;
    margin-top: 5px;
    line-height: 1.4;
  }

  /* ── Totals card ── */
  .totals-card {
    border: 1px solid #222;
    border-radius: 12px;
    padding: 20px 20px 16px;
    margin: 24px 0;
  }
  .totals-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: #444;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .macro-bar {
    margin-bottom: 10px;
  }
  .macro-bar-header {
    display: flex;
    justify-content: space-between;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    margin-bottom: 3px;
    color: #444;
  }
  .macro-bar-header .macro-name {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .macro-bar-track {
    height: 6px;
    background: #1e1e1e;
    border-radius: 3px;
    overflow: hidden;
  }
  .macro-bar-fill {
    height: 100%;
    border-radius: 3px;
  }

  /* ── Meal cards ── */
  .meal-card {
    margin-bottom: 8px;
  }
  .meal-header {
    border: 1px solid #1a1a1a;
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    user-select: none;
    transition: background 0.2s;
  }
  .meal-header.open {
    border-color: #2a2a2a;
    border-radius: 12px 12px 0 0;
  }
  .meal-emoji {
    font-size: 22px;
  }
  .meal-info {
    flex: 1;
  }
  .meal-title-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .meal-name {
    font-weight: 600;
    font-size: 15px;
  }
  .meal-time {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: #444;
  }
  .meal-macros {
    display: flex;
    gap: 12px;
    margin-top: 4px;
  }
  .meal-macros span {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
  }
  .chevron {
    color: #333;
    font-size: 18px;
    transition: transform 0.2s;
  }
  .chevron.open {
    transform: rotate(180deg);
  }
  .meal-body {
    display: none;
    border: 1px solid #2a2a2a;
    border-top: none;
    border-radius: 0 0 12px 12px;
    overflow: hidden;
  }
  .meal-body.open {
    display: block;
  }
  .item-row {
    display: flex;
    align-items: center;
    padding: 11px 20px;
    border-bottom: 1px solid #181818;
    gap: 12px;
  }
  .item-row:last-of-type {
    border-bottom: none;
  }
  .item-name {
    flex: 1;
    font-size: 13px;
    color: #444;
  }
  .item-macros {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .item-macros span {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    text-align: right;
  }
  .item-macros .cal {
    color: #666;
    width: 52px;
  }
  .item-macros .pro {
    color: #3a8f5c;
    width: 32px;
  }
  .item-macros .fat {
    color: #e07c3a;
    width: 28px;
  }
  .item-macros .carb {
    color: #5a9fe8;
    width: 28px;
  }
  .meal-note {
    padding: 12px 20px;
    font-size: 12px;
    color: #555;
    font-style: italic;
    line-height: 1.5;
  }
  .target-badge {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    color: #555;
    margin-left: 4px;
  }
  .target-badge.actual {
    background: #1a2e1a;
    color: #3a8f5c;
  }

  /* Hide print-only elements on screen */
  .print-notes,
  .print-checkbox,
  .print-role,
  .item-row.print-component {
    display: none;
  }

  /* ── Shopping list ── */
  .shopping-section {
    margin-top: 32px;
  }
  .shopping-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;

    @media screen and (min-width: 648px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .shopping-col-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: #444;
    text-transform: uppercase;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid #1a1a1a;
  }
  .shopping-badge {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
    background: #1a1a00;
    color: #666;
    letter-spacing: 0.06em;
  }
  .pantry-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px 16px;
    margin-top: 4px;

    @media screen and (min-width: 648px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pantry-item {
    font-size: 12px;
    color: #555;
    padding: 4px 0;
    border-bottom: 1px solid #111;
  }
  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    padding: 8px 16px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
    border: 1px solid #222;
    border-radius: 8px;
    cursor: pointer;
    background: transparent;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .print-btn:hover {
    border-color: #444;
    color: #888;
  }

  /* ── Footer ── */
  .footer-note {
    margin-top: 24px;
    padding: 16px 20px;
    border: 1px solid #1a1a1a;
    border-radius: 12px;
    font-size: 12px;
    color: #444;
    line-height: 1.7;
  }
  .footer-note code {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    padding: 1px 5px;
    border-radius: 3px;
    color: #666;
  }
</style>

<style is:global>
  .shopping-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 7px 10px;
    margin-bottom: 4px;
    border: 1px solid #e8e8e8;
    border-radius: 6px;
    gap: 8px;
  }
  .shopping-item.non-costco .shopping-item-name {
    color: #666;
  }
  .shopping-item-name {
    font-size: 13px;
    color: #666;
  }
  .shopping-item-qty {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: #444;
    white-space: nowrap;
  }

  /* ── Print styles ── */
  @media print {
    @page {
      margin: 0.45in;
    }

    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Shared: hide interactive chrome */
    .picker-section,
    .print-btn,
    .footer-note,
    .totals-card,
    header {
      display: none !important;
    }

    /* Shared: layout reset */
    main {
      padding: 0;
    }
    .main-inner {
      max-width: 100%;
    }

    /* ── Shopping list print (body.print-shopping) ── */
    body.print-shopping .meal-card,
    body.print-shopping .print-notes,
    body.print-shopping .daily-checklist {
      display: none !important;
    }
    body.print-shopping .shopping-section {
      margin-top: 0;
    }
    body.print-shopping .footer-note {
      display: none !important;
    }
    body.print-shopping footer {
      display: none !important;
    }
    body.print-shopping nav {
      display: none !important;
    }
    body.print-shopping .section-heading {
      margin: 8px 0 6px;
      font-size: 8px;
    }
    body.print-shopping .shopping-cols {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 8px !important;
    }
    body.print-shopping .shopping-col-label {
      font-size: 8px;
      margin-bottom: 4px;
      padding-bottom: 3px;
    }
    body.print-shopping .shopping-item {
      padding: 3px 7px;
      margin-bottom: 2px;
      border-color: #e0e0e0;
    }
    body.print-shopping .shopping-item-name {
      font-size: 10px;
    }
    body.print-shopping .shopping-item-qty {
      font-size: 9px;
    }
    body.print-shopping .pantry-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 2px 12px;
    }
    body.print-shopping .pantry-item {
      font-size: 9px;
      color: #666;
      padding: 2px 0;
    }

    /* ── Daily checklist print (body.print-checklist) ── */
    body.print-checklist .shopping-section {
      display: none !important;
    }
    body.print-checklist .footer-note {
      display: none !important;
    }
    body.print-checklist footer {
      display: none !important;
    }
    body.print-checklist nav {
      display: none !important;
    }

    body.print-checklist .print-notes {
      display: block !important;
      margin-top: 10px;
      border: 1px solid #2a2a2a;
      border-radius: 6px;
      padding: 8px 12px;
    }
    body.print-checklist .print-notes-label {
      font-family: 'DM Mono', monospace;
      font-size: 8px;
      letter-spacing: 0.12em;
      color: #444;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    body.print-checklist .print-notes-lines {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    body.print-checklist .print-notes-line {
      border-bottom: 1px solid #222;
      height: 1px;
    }

    body.print-checklist .meal-card {
      break-inside: avoid;
      margin-bottom: 4px;
    }
    body.print-checklist .meal-header {
      cursor: default;
      border-radius: 6px 6px 0 0 !important;
      border-color: #2a2a2a !important;
      padding: 6px 10px;
      gap: 8px;
    }
    body.print-checklist .meal-body {
      display: block !important;
      border-color: #2a2a2a;
      border-radius: 0 0 6px 6px;
    }
    body.print-checklist .meal-emoji {
      font-size: 14px;
    }
    body.print-checklist .meal-name {
      font-size: 12px;
    }
    body.print-checklist .meal-time {
      font-size: 9px;
    }
    body.print-checklist .meal-macros {
      margin-top: 1px;
      gap: 8px;
    }
    body.print-checklist .meal-macros span {
      font-size: 9px;
    }
    body.print-checklist .chevron {
      display: none;
    }

    body.print-checklist .item-row:not(.print-component) {
      display: none !important;
    }

    body.print-checklist .item-row.print-component {
      display: flex !important;
      align-items: center;
      padding: 5px 10px;
      gap: 8px;
      border-bottom: 1px solid #1a1a1a;
    }
    body.print-checklist .item-row.print-component:last-of-type {
      border-bottom: none;
    }

    body.print-checklist .print-checkbox {
      display: block !important;
      width: 11px;
      height: 11px;
      min-width: 11px;
      border: 1px solid #3a3a3a;
      border-radius: 2px;
      flex-shrink: 0;
    }
    body.print-checklist .print-role {
      display: block !important;
      font-family: 'DM Mono', monospace;
      font-size: 7px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #555;
      width: 38px;
      min-width: 38px;
      flex-shrink: 0;
    }
    body.print-checklist .item-name {
      font-size: 10px;
      color: #ccc;
      flex: 1;
    }

    body.print-checklist .item-row.print-component.no-macros .item-macros {
      display: none;
    }
    body.print-checklist .item-row.print-component .item-macros {
      display: flex;
      gap: 6px;
    }
    body.print-checklist .item-row.print-component .item-macros .fat,
    body.print-checklist .item-row.print-component .item-macros .carb {
      display: none;
    }
    body.print-checklist .item-row.print-component .item-macros .cal,
    body.print-checklist .item-row.print-component .item-macros .pro {
      font-size: 8px;
      color: #555;
      width: auto;
    }
    body.print-checklist .meal-note {
      display: none !important;
    }
  }
</style>

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <header>
    <div class="header-inner">
      <p class="eyebrow">Daily Meal Plan</p>
      <h1 id="header-cal">{totals.calories} cal<br /><span>cut protocol</span></h1>
      <p class="subtitle">278 lb → 200 lb goal · daily template</p>
    </div>
  </header>

  <main>
    <div class="main-inner">
      <!-- ── Week picker ── -->
      <div class="picker-section">
        <p class="section-heading">This week — dinner</p>
        <div class="picker-grid" id="dinner-picker">
          {
            dinnerOptions.map(dish => (
              <div
                class={`picker-card${dish.id === thisWeek.dinner ? ' selected' : ''}`}
                data-type="dinner"
                data-id={dish.id}
                data-cal={dish.target.calories}
                data-pro={dish.target.protein}
                data-fat={dish.target.fat}
                data-carb={dish.target.carbs}
                data-label={dish.label}
                data-emoji={dish.emoji}
                data-note={dish.prepNote}
              >
                <div class="picker-card-cuisine">{dish.cuisine}</div>
                <div class="picker-card-name">
                  <span>{dish.emoji}</span>
                  <span>{dish.label}</span>
                </div>
                <a class="picker-card-link" href={dish.recipeUrl} target="_blank">
                  view recipe →
                </a>
                <div class="picker-card-macros">
                  {dish.target.calories} cal · {dish.target.protein}p · {dish.target.fat}f ·{' '}
                  {dish.target.carbs}c
                </div>
                <div class="picker-card-desc">{dish.description}</div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ── Daily Totals ── -->
      <div class="totals-card" id="totals-card">
        <p class="totals-label">Daily Totals</p>
        {
          [
            {
              label: 'Calories',
              key: 'calories',
              value: totals.calories,
              target: TARGETS.calories,
              color: '#c8a527',
            },
            {
              label: 'Protein (g)',
              key: 'protein',
              value: totals.protein,
              target: TARGETS.protein,
              color: '#3a8f5c',
            },
            {
              label: 'Fat (g)',
              key: 'fat',
              value: totals.fat,
              target: TARGETS.fat,
              color: '#e07c3a',
            },
            {
              label: 'Carbs (g)',
              key: 'carbs',
              value: totals.carbs,
              target: TARGETS.carbs,
              color: '#5a9fe8',
            },
          ].map(({ label, key, value, target, color }) => {
            const pct = Math.min((value / target) * 100, 100);
            const atTarget = pct >= 95;
            return (
              <div class="macro-bar" data-macro={key}>
                <div class="macro-bar-header">
                  <span class="macro-name">{label}</span>
                  <span
                    class="macro-value"
                    data-target={target}
                    data-color={color}
                    style={atTarget ? `color: ${color}` : 'color: #444'}
                  >
                    {value}
                    <span style="color: #555">/{target}</span>
                  </span>
                </div>
                <div class="macro-bar-track">
                  <div
                    class="macro-bar-fill"
                    data-target={target}
                    style={`width: ${pct}%; background: ${color};`}
                  />
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- ── Meal Cards ── -->
      {
        meals.map((meal, idx) => {
          const mt = mealTotals(meal);
          const isFirst = idx === 0;
          const isDinner = meal.id === 'dinner';
          const hasActual = isDinner ? thisWeek.dinnerActual !== null : false;

          return (
            <div class="meal-card" data-meal-id={meal.id}>
              <div class={`meal-header${isFirst ? ' open' : ''}`} data-toggle={meal.id}>
                <span class="meal-emoji">{meal.emoji}</span>
                <div class="meal-info">
                  <div class="meal-title-row">
                    <span class="meal-name" data-meal-name={meal.id}>
                      {meal.name}
                    </span>
                    <span class="meal-time">{meal.time}</span>
                    {isDinner && (
                      <span class={`target-badge${hasActual ? ' actual' : ''}`}>
                        {hasActual ? 'actual' : 'target'}
                      </span>
                    )}
                  </div>
                  <div class="meal-macros" data-meal-macros={meal.id}>
                    <span style="color: #c8a527">{mt.calories} cal</span>
                    <span style="color: #3a8f5c">{mt.protein}p</span>
                    <span style="color: #e07c3a">{mt.fat}f</span>
                    <span style="color: #5a9fe8">{mt.carbs}c</span>
                  </div>
                </div>
                <span class={`chevron${isFirst ? ' open' : ''}`}>▾</span>
              </div>

              <div class={`meal-body${isFirst ? ' open' : ''}`} id={`body-${meal.id}`}>
                {meal.items.map(item => (
                  <div class="item-row" data-item-row={meal.id}>
                    <span class="item-name">{item.name}</span>
                    <div class="item-macros">
                      <span class="cal">{item.calories} cal</span>
                      <span class="pro">{item.protein}p</span>
                      <span class="fat">{item.fat}f</span>
                      <span class="carb">{item.carbs}c</span>
                    </div>
                  </div>
                ))}
                {isDinner &&
                  selectedDinner.components.map(c => (
                    <div class="item-row print-component no-macros">
                      <span class="print-checkbox" />
                      <span class="print-role">{c.role}</span>
                      <span class="item-name">{c.description}</span>
                    </div>
                  ))}
                {!isDinner &&
                  meal.items.map(item => (
                    <div class="item-row print-component">
                      <span class="print-checkbox" />
                      <span class="print-role" />
                      <span class="item-name">{item.name}</span>
                      <div class="item-macros">
                        <span class="cal">{item.calories} cal</span>
                        <span class="pro">{item.protein}p</span>
                      </div>
                    </div>
                  ))}
                <p class="meal-note" data-meal-note={meal.id}>
                  💡 {meal.note}
                </p>
              </div>
            </div>
          );
        })
      }

      <!-- ── Shopping List ── -->
      <div class="shopping-section">
        <p class="section-heading">Shopping list — this week</p>
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px;">
          <button class="print-btn" id="print-checklist-btn">☑ Print daily checklist</button>
          <button class="print-btn" id="print-shopping-btn">⎙ Print shopping list</button>
        </div>

        <div class="shopping-cols" style="margin-top: 16px;">
          <div>
            <div class="shopping-col-label">Costco</div>
            <div id="costco-list"></div>
          </div>
          <div>
            <div class="shopping-col-label">Other / specialty</div>
            <div id="other-list"></div>
          </div>
        </div>

        <p class="section-heading" style="margin-top: 28px;">
          Pantry staples — check before you go
        </p>
        <div class="pantry-list">
          {pantryStaples.map(item => <div class="pantry-item">{item}</div>)}
        </div>
      </div>

      <!-- ── Print notes block (print only) ── -->
      <div class="print-notes">
        <div class="print-notes-label">Notes</div>
        <div class="print-notes-lines">
          {Array.from({ length: 6 }).map(() => <div class="print-notes-line" />)}
        </div>
      </div>

      <div class="footer-note">
        <strong style="color: #555;">Each Sunday:</strong> Pick a dinner above — the daily
        plan, macros, and shopping list update instantly. Change <code>thisWeek.dinner</code> in{' '}
        <code>mealPrepTargets.ts</code> to persist your selection across deploys. Set{' '}
        <code>dinnerActual</code> once you've calculated per-serving macros.
      </div>
    </div>
  </main>
</Layout>

<script
  define:vars={{
    dinnerDishesData: Object.values(dinnerDishes),
    fixedMealsData: fixedMeals,
    initialDinnerId: thisWeek.dinner,
  }}
>
  // ── State ──
  let selectedDinnerId = initialDinnerId;

  const dinnerMap = Object.fromEntries(dinnerDishesData.map(d => [d.id, d]));

  // Fixed meal totals (breakfast + salmon salad + shake + yogurt)
  function sumItems(items) {
    return items.reduce(
      (a, i) => ({
        calories: a.calories + i.calories,
        protein: a.protein + i.protein,
        fat: a.fat + i.fat,
        carbs: a.carbs + i.carbs,
      }),
      { calories: 0, protein: 0, fat: 0, carbs: 0 }
    );
  }

  const fixedTotals = fixedMealsData.reduce(
    (acc, meal) => {
      const s = sumItems(meal.items);
      return {
        calories: acc.calories + s.calories,
        protein: acc.protein + s.protein,
        fat: acc.fat + s.fat,
        carbs: acc.carbs + s.carbs,
      };
    },
    { calories: 0, protein: 0, fat: 0, carbs: 0 }
  );

  // ── Rebuild shopping list ──
  function buildShoppingList() {
    const dinner = dinnerMap[selectedDinnerId];

    const allItems = [
      ...fixedMealsData.flatMap(m => m.shoppingList),
      ...dinner.shoppingList,
    ];

    const seen = new Map();
    for (const item of allItems) {
      if (!seen.has(item.item)) seen.set(item.item, item);
    }
    const unique = Array.from(seen.values());
    const costco = unique.filter(i => i.costco);
    const other = unique.filter(i => !i.costco);

    function renderItems(items, containerId) {
      const el = document.getElementById(containerId);
      if (!el) return;
      el.innerHTML = items
        .map(
          i => `
        <div class="shopping-item${i.costco ? '' : ' non-costco'}">
          <span class="shopping-item-name">${i.item}</span>
          <span class="shopping-item-qty">${i.qty}</span>
        </div>
      `
        )
        .join('');
    }

    renderItems(costco, 'costco-list');
    renderItems(other, 'other-list');
  }

  // ── Update meal card (lunch or dinner) ──
  function updateMealCard(dish) {
    const nameEl = document.querySelector(`[data-meal-name="dinner"]`);
    const macrosEl = document.querySelector(`[data-meal-macros="dinner"]`);
    const noteEl = document.querySelector(`[data-meal-note="dinner"]`);
    const itemRows = document.querySelectorAll(`[data-item-row="dinner"]`);

    if (nameEl) nameEl.textContent = dish.label;
    if (macrosEl)
      macrosEl.innerHTML = `
      <span style="color: #c8a527">${dish.target.calories} cal</span>
      <span style="color: #3a8f5c">${dish.target.protein}p</span>
      <span style="color: #e07c3a">${dish.target.fat}f</span>
      <span style="color: #5a9fe8">${dish.target.carbs}c</span>
    `;
    if (noteEl) noteEl.textContent = '💡 ' + dish.prepNote;

    // Update item row
    if (itemRows.length > 0) {
      itemRows[0].querySelector('.item-name').textContent = '1 of 10 portions (target)';
      const spans = itemRows[0].querySelectorAll('.item-macros span');
      if (spans[0]) spans[0].textContent = dish.target.calories + ' cal';
      if (spans[1]) spans[1].textContent = dish.target.protein + 'p';
      if (spans[2]) spans[2].textContent = dish.target.fat + 'f';
      if (spans[3]) spans[3].textContent = dish.target.carbs + 'c';
    }
  }

  // ── Update totals bars ──
  function updateTotals() {
    const dinner = dinnerMap[selectedDinnerId].target;
    const total = {
      calories: fixedTotals.calories + dinner.calories,
      protein: fixedTotals.protein + dinner.protein,
      fat: fixedTotals.fat + dinner.fat,
      carbs: fixedTotals.carbs + dinner.carbs,
    };

    const headerCal = document.getElementById('header-cal');
    if (headerCal) headerCal.innerHTML = `${total.calories} cal<br /><span>cut protocol</span>`;

    for (const key of ['calories', 'protein', 'fat', 'carbs']) {
      const bar = document.querySelector(`[data-macro="${key}"]`);
      if (!bar) continue;
      const valueEl = bar.querySelector('.macro-value');
      const fillEl = bar.querySelector('.macro-bar-fill');
      const target = parseInt(valueEl.dataset.target);
      const color = valueEl.dataset.color;
      const value = total[key];
      const pct = Math.min((value / target) * 100, 100);
      const atTarget = pct >= 95;
      valueEl.innerHTML = `${value}<span style="color: #555">/${target}</span>`;
      valueEl.style.color = atTarget ? color : '#444';
      fillEl.style.width = pct + '%';
    }
  }

  // ── Picker click handler ──
  document.querySelectorAll('.picker-card').forEach(card => {
    card.addEventListener('click', () => {
      const id = card.dataset.id;

      document
        .querySelectorAll(`.picker-card[data-type="dinner"]`)
        .forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');

      selectedDinnerId = id;
      updateMealCard(dinnerMap[id]);

      updateTotals();
      buildShoppingList();
    });
  });

  // ── Accordion ──
  Array.from(document.querySelectorAll('[data-toggle]')).forEach(header => {
    header.addEventListener('click', () => {
      const id = header.dataset.toggle;
      const body = document.getElementById(`body-${id}`);
      const chevron = header.querySelector('.chevron');
      const isOpen = body.classList.contains('open');
      document.querySelectorAll('.meal-body').forEach(b => b.classList.remove('open'));
      document.querySelectorAll('.meal-header').forEach(h => {
        h.classList.remove('open');
        h.querySelector('.chevron')?.classList.remove('open');
      });
      if (!isOpen) {
        body.classList.add('open');
        header.classList.add('open');
        chevron?.classList.add('open');
      }
    });
  });

  // ── Init shopping list on load ──
  buildShoppingList();

  // ── Print buttons ──
  function printWith(cls) {
    document.body.classList.add(cls);
    window.print();
    window.addEventListener('afterprint', () => document.body.classList.remove(cls), {
      once: true,
    });
  }

  document
    .getElementById('print-checklist-btn')
    ?.addEventListener('click', () => printWith('print-checklist'));
  document
    .getElementById('print-shopping-btn')
    ?.addEventListener('click', () => printWith('print-shopping'));
</script>