---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../constants';
import Layout from '../../../layouts/DefaultPageLayout.astro';
import { dayTimeline, flexBackfill, TARGETS, trackedTotals } from '../../../utils/mealPrepTargets';

const macros = [
  {
    label: 'Calories',
    value: trackedTotals.calories,
    target: TARGETS.calories,
    unit: '',
    color: '#c8a527',
  },
  {
    label: 'Protein',
    value: trackedTotals.protein,
    target: TARGETS.protein,
    unit: 'g',
    color: '#3a8f5c',
  },
  { label: 'Fat', value: trackedTotals.fat, target: TARGETS.fat, unit: 'g', color: '#e07c3a' },
  {
    label: 'Carbs',
    value: trackedTotals.carbs,
    target: TARGETS.carbs,
    unit: 'g',
    color: '#5a9fe8',
  },
];
---

<style>
  header {
    border-bottom: 1px solid #1e1e1e;
    padding: 40px 24px 32px;
  }
  .header-inner,
  .main-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #555;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  h1 span {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #666;
    text-transform: uppercase;
  }
  .subtitle {
    color: #555;
    font-size: 13px;
    margin-top: 12px;
    line-height: 1.6;
  }
  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 24px 48px;
  }
  .section-heading {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #444;
    text-transform: uppercase;
    margin: 36px 0 14px;
  }

  /* ── Macro grid ── */
  .macro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 32px 0 8px;
  }
  .macro-card {
    border: 1px solid #222;
    border-radius: 12px;
    padding: 18px 18px 16px;
    position: relative;
    overflow: hidden;
  }
  .macro-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    opacity: 0.75;
  }
  .macro-card-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #555;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .macro-card-value {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
    color: var(--accent);
  }
  .macro-card-target {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: #555;
    font-weight: 400;
    margin-left: 4px;
  }
  .macro-card-unit {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    font-weight: 400;
    color: #666;
    letter-spacing: 0.06em;
  }
  .macro-card-bar {
    height: 4px;
    background: #161616;
    border-radius: 2px;
    margin-top: 10px;
    overflow: hidden;
  }
  .macro-card-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    opacity: 0.8;
  }

  /* ── Timeline ── */
  .timeline {
    position: relative;
    margin: 12px 0 0;
    padding-left: 28px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 28px;
    width: 1px;
    background: linear-gradient(to bottom, #2a2a2a, #2a2a2a 70%, #1a1a1a);
  }
  .stop {
    position: relative;
    margin-bottom: 24px;
  }
  .stop:last-of-type {
    margin-bottom: 12px;
  }
  .stop-dot {
    position: absolute;
    left: -28px;
    top: 4px;
    width: 23px;
    height: 23px;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    line-height: 1;
  }
  .stop-time {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: #888;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .stop-title {
    font-family: 'Playfair Display', serif;
    font-size: 19px;
    font-weight: 700;
    color: #d8d8d8;
    margin-bottom: 6px;
    line-height: 1.2;
  }
  .stop-title a {
    color: #d8d8d8;
    text-decoration: none;
    border-bottom: 1px solid #5a4416;
    transition: border-color 0.15s;
  }
  .stop-title a:hover {
    border-bottom-color: #c8a527;
  }
  .stop-title .recipe-arrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: #c8a527;
    margin-left: 6px;
    letter-spacing: 0.06em;
    border-bottom: none;
  }
  .stop-detail {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .stop-macros {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .stop-macros span.cal {
    color: #c8a527;
  }
  .stop-macros span.pro {
    color: #3a8f5c;
  }
  .stop-macros span.fat {
    color: #e07c3a;
  }
  .stop-macros span.carb {
    color: #5a9fe8;
  }

  /* ── Flex stop (dashed) ── */
  .stop.flex .stop-dot {
    border-style: dashed;
    opacity: 0.7;
  }
  .stop.flex .stop-title {
    color: #888;
    font-style: italic;
    font-size: 17px;
  }

  /* ── Notes ── */
  .notes {
    margin-top: 24px;
    padding: 16px 20px;
    border: 1px solid #1a1a1a;
    border-radius: 12px;
    font-size: 12px;
    color: #666;
    line-height: 1.7;
  }
  .notes-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #444;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .notes p {
    margin: 0 0 8px;
  }
  .notes p:last-child {
    margin-bottom: 0;
  }
  .notes strong {
    color: #c8a527;
    font-weight: 500;
  }
</style>

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <header>
    <div class="header-inner">
      <p class="eyebrow">Daily Macros</p>
      <h1>{TARGETS.calories} cal<br /><span>cut protocol</span></h1>
      <p class="subtitle">
        A typical day. Dinner rotates weekly — recipes live on the meal prep page.
      </p>
    </div>
  </header>

  <main>
    <div class="main-inner">
      <!-- ── Targets vs tracked ── -->
      <p class="section-heading">Tracked meals vs targets</p>
      <div class="macro-grid">
        {
          macros.map(m => {
            const pct = Math.min((m.value / m.target) * 100, 100);
            return (
              <div class="macro-card" style={`--accent: ${m.color}`}>
                <div class="macro-card-label">{m.label}</div>
                <div class="macro-card-value">
                  {m.value}
                  <span class="macro-card-unit">{m.unit}</span>
                  <span class="macro-card-target">
                    / {m.target}
                    {m.unit}
                  </span>
                </div>
                <div class="macro-card-bar">
                  <div class="macro-card-bar-fill" style={`width: ${pct}%`} />
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- ── Day timeline ── -->
      <p class="section-heading">How the day unfolds</p>
      <div class="timeline">
        {
          dayTimeline.map(stop => (
            <div class="stop">
              <span class="stop-dot">{stop.emoji}</span>
              <div class="stop-time">{stop.time}</div>
              <div class="stop-title">
                {stop.href ? (
                  <a href={stop.href}>
                    {stop.label}
                    <span class="recipe-arrow">recipe →</span>
                  </a>
                ) : (
                  stop.label
                )}
              </div>
              <div class="stop-detail">{stop.detail}</div>
              <div class="stop-macros">
                <span class="cal">{stop.macros.calories} cal</span>
                <span class="pro">{stop.macros.protein}p</span>
                <span class="fat">{stop.macros.fat}f</span>
                <span class="carb">{stop.macros.carbs}c</span>
              </div>
            </div>
          ))
        }

        <!-- Flex backfill as a dashed timeline stop -->
        <div class="stop flex">
          <span class="stop-dot">🍎</span>
          <div class="stop-time">Throughout</div>
          <div class="stop-title">Flex backfill</div>
          <div class="stop-detail">{flexBackfill.detail}</div>
          <div class="stop-macros">
            <span class="cal">~{flexBackfill.calories} cal</span>
          </div>
        </div>
      </div>

      <!-- ── Reference notes ── -->
      <div class="notes">
        <div class="notes-label">Reference</div>
        <p>
          <strong>Fruit rotation</strong>: medium apple ≈ 95 cal / 25c · medium banana ≈ 105 cal /
          27c · medium pear ≈ 100 cal / 27c · cara cara orange ≈ 80 cal / 20c · plum ≈ 30 cal / 8c.
        </p>
        <p>
          <strong>Cheese stick</strong> ≈ 80 cal / 6p / 6f.
        </p>
        <p>
          <strong>Gym days</strong> (Tue/Fri): add a protein shake post-workout (~180 cal / 30p). Uncounted
          on purpose.
        </p>
      </div>
    </div>
  </main>
</Layout>
