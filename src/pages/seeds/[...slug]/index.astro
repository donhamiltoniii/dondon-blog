---
import { render } from 'astro:content';
import Layout from '../../../layouts/SeedLayout.astro';
import { getAllSeedAssets, type Seed } from '../../../utils/seeds';

export async function getStaticPaths() {
  const seeds = await getAllSeedAssets();
  return seeds.map((seed: Seed) => {
    const slugArr = seed.id.split('/');
    const paraSection = slugArr.unshift();
    const slug = slugArr.join('/');

    return {
      params: { paraSection, slug },
      props: { seed },
    };
  });
}

type Props = { seed: Seed };

const { seed } = Astro.props;
const { Content } = await render(seed);
---

<Layout {...seed.data}>
  <Content />
</Layout>
